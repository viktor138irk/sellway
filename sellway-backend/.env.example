# ── Server ───────────────────────────────────────
PORT=3001
NODE_ENV=production
FRONTEND_URL=https://sellway.pro
PUBLIC_SITE_URL=https://sellway.pro

# ── Database ─────────────────────────────────────
DATABASE_URL=postgresql://sellway_user:password@localhost:5432/sellway_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sellway_db
DB_USER=sellway_user
DB_PASS=your_strong_password

# ── JWT ──────────────────────────────────────────
JWT_SECRET=your_very_long_random_secret_key_min_64_chars
JWT_REFRESH_SECRET=another_very_long_random_secret_key_min_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# ── Email (SMTP) ──────────────────────────────────
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@sellway.pro
SMTP_PASS=your_email_password

# ── File Upload ───────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
UPLOAD_URL=https://sellway.pro/uploads

# ── Telegram Bot ──────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_BOT_USERNAME=your_public_bot_username
TELEGRAM_ADMIN_BOT_TOKEN=your_admin_bot_token_from_botfather
TELEGRAM_ADMIN_BOT_USERNAME=your_admin_bot_username
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id

# ── SOCKS5 Proxy (для Telegram бота) ─────────────
PROXY_ENABLED=false
PROXY_SCHEME=socks5h
PROXY_HOST=127.0.0.1
PROXY_PORT=1080
PROXY_USERNAME=
PROXY_PASSWORD=

# ── Payments (ЮKassa) ─────────────────────────────
YUKASSA_SHOP_ID=your_shop_id
YUKASSA_SECRET_KEY=your_secret_key
PAYMENT_RETURN_URL=https://sellway.pro/payment/success
# В ЮKassa укажи webhook URL: https://pay.vpulse.fun/api/payments/webhook
PAYMENT_WEBHOOK_URL=https://pay.vpulse.fun/api/payments/webhook

# ── SMSPilot ───────────────────────────────────────
SMSPILOT_ENABLED=false
SMSPILOT_API_KEY=your_smspilot_api_key
SMSPILOT_SENDER=
SMS_CODE_TEMPLATE=Ваш код подтверждения {{code}}

# ── Commission ───────────────────────────────────
PLATFORM_COMMISSION=0.07

# ── Escrow ───────────────────────────────────────
ESCROW_AUTO_CONFIRM_HOURS=48
DISPUTE_OPEN_HOURS=24
